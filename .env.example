# ==============================================================================
# UniMetric Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
# Fill in your own values below. DO NOT commit '.env' to version control.
# ==============================================================================

# Backend REST API Base Endpoint
VITE_API_BASE_URL=http://localhost:8000/api

# ==============================================================================
# Supabase Authentication & Client Configuration
# ==============================================================================
# In Supabase Dashboard -> Project Settings -> API:
# 1. Project URL (e.g., https://xyzcompany.supabase.co):
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Project API Key -> "anon" (Public client key):
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
