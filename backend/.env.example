# ==========================================
# UniMetric Backend Environment Variables
# ==========================================

# OPTION 1: Supabase Database (Recommended)
# Replace with your Supabase connection string from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Or Transaction/Session Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# OPTION 2: Individual Database Parameters (Local or Remote Postgres)
DB_NAME=unimetric_db
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
