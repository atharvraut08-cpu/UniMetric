# ==============================================================================
# UniMetric Backend Environment Configuration Template
# ==============================================================================
# Copy this file to 'backend/.env':
#   cp backend/.env.example backend/.env
# Fill in your own values below. DO NOT commit 'backend/.env' to version control.
# ==============================================================================

# ==============================================================================
# Django Security & Core Settings
# ==============================================================================
# Generate a secure key using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-django-secret-key-here
DJANGO_SECRET_KEY=your-django-secret-key-here

# Set to False in production
DJANGO_DEBUG=True
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# ==============================================================================
# Database Configuration
# ==============================================================================

# OPTION 1: Supabase / Cloud PostgreSQL (Recommended)
# In Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Pooler connection string format:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require

# OPTION 2: Local PostgreSQL Fallback (Active when DATABASE_URL is empty)
DB_NAME=unimetric_db
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
